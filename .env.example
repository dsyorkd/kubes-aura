# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# Pi-Controller Integration (Required for backend connectivity)
VITE_PI_CONTROLLER_URL="http://localhost:8765"        # Pi-controller backend server URL
VITE_API_BASE_URL="http://localhost:8765/api"         # API base URL for HTTP requests
VITE_SOCKET_IO_URL="http://localhost:8765"            # Socket.io server URL for real-time communication

# Application Configuration
VITE_APP_NAME="Kubes Aura"                           # Application display name
VITE_APP_VERSION="1.0.0"                             # Application version
VITE_ENVIRONMENT="development"                       # Environment: development, staging, production

# Security Configuration
VITE_SESSION_TIMEOUT="3600000"                       # Session timeout in milliseconds (1 hour)
VITE_TOKEN_REFRESH_INTERVAL="300000"                 # Token refresh interval in milliseconds (5 minutes)

# Feature Flags
VITE_ENABLE_GPIO_CONTROLS="true"                     # Enable GPIO control features
VITE_ENABLE_CLUSTER_MANAGEMENT="true"                # Enable cluster management features
VITE_ENABLE_MONITORING="true"                        # Enable monitoring dashboard
VITE_ENABLE_SENTRY="false"                           # Enable Sentry error tracking (set to true in production)

# Sentry Configuration (Optional, for error tracking)
VITE_SENTRY_DSN=""                                   # Sentry DSN for error tracking
VITE_SENTRY_ENVIRONMENT="development"                # Sentry environment